[Unit]
Description=Forgejo git service
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Container]
Image=codeberg.org/forgejo/forgejo:16-rootless
AutoUpdate=registry
ContainerName=forgejo
Network=diskette.network
PublishPort=3000:3000
PublishPort=2222:22
Volume=/srv/projects/repositories:/repositories
Volume=/srv/projects/packages:/packages
Volume=/srv/appdata/forgejo/data:/var/lib/gitea
Volume=/srv/appdata/forgejo/config:/etc/gitea
Environment=GITEA__repository__ROOT=/repositories
Environment=GITEA__storage_packages__PATH=/packages
Environment=TZ=Europe/Amsterdam
UserNS=keep-id:uid=1000,gid=1000

# Health check
HealthCmd=curl -f http://localhost:3000/api/healthz || exit 1
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3

[Service]
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=default.target
