[Unit]
Description=Samba
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Container]
Image=docker.io/dockurr/samba:latest
ContainerName=samba
Network=diskette.network
AutoUpdate=registry
PublishPort=4455:445
Volume=/srv/media:/shared
Environment=NAME=media
Environment=UID=1000
Environment=GID=1000
Secret=SAMBA_USER,type=env,target=USER
Secret=SAMBA_PASSWORD,type=env,target=PASS
UserNS=keep-id:uid=1000,gid=1000

[Service]
SuccessExitStatus=0 126
Restart=always
TimeoutStartSec=900

[Install]
WantedBy=default.target
